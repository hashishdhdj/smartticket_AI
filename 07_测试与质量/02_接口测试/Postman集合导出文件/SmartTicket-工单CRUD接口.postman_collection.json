{
  "info": {
    "name": "SmartTicket 工单接口（阶段1 收官 · 8 个接口）",
    "_postman_id": "b7c1e2f4-3a55-4c8e-9d21-6f0a1c9d4e77",
    "description": "2026-10-19错误契约更新：异常采用明确HTTP状态，业务code保留。旧鉴权关闭示例仅作接口练习；当前鉴权流程以阶段四集合为准。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 创建工单 POST /api/tickets",
      "item": [
        {
          "name": "1.1 创建工单（正常）——并记录 id 供后续用例使用",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('统一返回格式：code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('状态固定为待分配', () => pm.expect(json.data.status).to.eql('PENDING_ASSIGN'));",
                  "pm.test('优先级为入参 HIGH', () => pm.expect(json.data.priority).to.eql('HIGH'));",
                  "pm.test('工单编号符合 ST-yyyyMMdd-HHmmss-XXXX 规则', () => pm.expect(json.data.ticketNo).to.match(/^ST-\\d{8}-\\d{6}-[0-9A-F]{4}$/));",
                  "pm.test('creatorId 与入参一致', () => pm.expect(json.data.creatorId).to.eql(1));",
                  "pm.test('createdAt 已由数据库填充', () => pm.expect(json.data.createdAt).to.be.a('string').and.not.empty);",
                  "pm.test('不返回内部字段 deleted', () => pm.expect(json.data).to.not.have.property('deleted'));",
                  "pm.collectionVariables.set('id', json.data.id);",
                  "console.log('已创建工单 id = ' + json.data.id + '，编号 = ' + json.data.ticketNo);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"打印机无法连接\",\n  \"description\": \"办公室3楼打印机离线\",\n  \"category\": \"硬件设备\",\n  \"priority\": \"HIGH\",\n  \"tags\": \"打印,硬件\",\n  \"creatorId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "创建工单：状态由服务端固定为 PENDING_ASSIGN，工单编号由服务端生成。"
          }
        },
        {
          "name": "1.2 创建工单（不传 priority，应取数据库默认值 MEDIUM）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('priority 回落为 MEDIUM', () => pm.expect(json.data.priority).to.eql('MEDIUM'));",
                  "// 这条工单保持待分配状态，作为 6.4~6.6 关闭/指派用例的目标",
                  "pm.collectionVariables.set('closedId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"会议室投屏失败\",\n  \"creatorId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "不传优先级时由服务端显式写入 MEDIUM，保证出参与库内一致。"
          }
        },
        {
          "name": "1.3 创建工单（标题为空白，应 40000）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 仍为 200（业务码与传输层解耦）', () => pm.response.to.have.status(400));",
                  "pm.test('code=40000 参数校验失败', () => pm.expect(json.code).to.eql(40000));",
                  "pm.test('message 指明字段 title', () => pm.expect(json.message).to.include('title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \",\n  \"creatorId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "@NotBlank 生效，返回 40000 并带字段级提示。"
          }
        },
        {
          "name": "1.4 创建工单（缺 creatorId，应 40000）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=40000', () => pm.expect(json.code).to.eql(40000));",
                  "pm.test('message 指明字段 creatorId', () => pm.expect(json.message).to.include('creatorId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"缺少创建人的工单\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "creator_id 为 NOT NULL，阶段1 无登录体系，创建人必须显式传入。"
          }
        }
      ]
    },
    {
      "name": "2. 查询详情 GET /api/tickets/{id}",
      "item": [
        {
          "name": "2.1 查询详情（使用 1.1 创建的 id）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('id 与请求一致', () => pm.expect(String(json.data.id)).to.eql(pm.collectionVariables.get('id')));",
                  "pm.test('不返回内部字段 deleted', () => pm.expect(json.data).to.not.have.property('deleted'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{id}}"
              ]
            },
            "description": "按 id 查询详情。若未先执行 1.1，{{id}} 为空，会命中 10003。"
          }
        },
        {
          "name": "2.2 查询详情（不存在的工单，应 10003）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=10003 工单不存在', () => pm.expect(json.code).to.eql(10003));",
                  "pm.test('message 含被查询的 id', () => pm.expect(json.message).to.include('999999999'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "999999999"
              ]
            },
            "description": "不存在的 id 返回业务码 10003，而不是空 body 或 500。"
          }
        }
      ]
    },
    {
      "name": "3. 分页查询 GET /api/tickets",
      "item": [
        {
          "name": "3.1 分页查询（默认参数）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('返回 PageVO 五个字段', () => {",
                  "  pm.expect(json.data).to.have.all.keys('records', 'total', 'current', 'size', 'pages');",
                  "});",
                  "pm.test('records 是数组', () => pm.expect(json.data.records).to.be.an('array'));",
                  "pm.test('current=1 且 size=10', () => {",
                  "  pm.expect(json.data.current).to.eql(1);",
                  "  pm.expect(json.data.size).to.eql(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?current=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "current",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "默认按 created_at DESC, id DESC 排序。若不注册分页插件，这里会返回全表且 total 不准。"
          }
        },
        {
          "name": "3.2 分页查询（按状态筛选 PENDING_ASSIGN）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('返回记录的 status 全部为 PENDING_ASSIGN', () => {",
                  "  json.data.records.forEach((record) => pm.expect(record.status).to.eql('PENDING_ASSIGN'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?status=PENDING_ASSIGN&size=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING_ASSIGN"
                },
                {
                  "key": "size",
                  "value": "100"
                }
              ]
            },
            "description": "状态筛选复用状态机的取值校验，非法值会返回 10002 而不是静默查空。"
          }
        },
        {
          "name": "3.3 分页查询（size 超上限 100，应 40000）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=40000', () => pm.expect(json.code).to.eql(40000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?size=101",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "101"
                }
              ]
            },
            "description": "Controller 上的 @Validated + @Max(100) 生效，防止一次性拉全表。"
          }
        },
        {
          "name": "3.4 分页查询（非法状态值，应 10002）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=10002 未知的工单状态值', () => pm.expect(json.code).to.eql(10002));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?status=NOT_A_STATUS",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "NOT_A_STATUS"
                }
              ]
            },
            "description": "TicketStatus.fromCode 抛业务异常，错误码 10002。"
          }
        }
      ]
    },
    {
      "name": "4. 更新工单 PUT /api/tickets/{id}",
      "item": [
        {
          "name": "4.1 更新工单（改 title/priority，清空 description/tags）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('title 已更新', () => pm.expect(json.data.title).to.eql('打印机无法连接（已重新处理）'));",
                  "pm.test('priority 已更新为 URGENT', () => pm.expect(json.data.priority).to.eql('URGENT'));",
                  "pm.test('description 已被清空（null 字段被省略）', () => pm.expect(json.data).to.not.have.property('description'));",
                  "pm.test('tags 已被清空', () => pm.expect(json.data).to.not.have.property('tags'));",
                  "pm.test('状态未被修改，仍为 PENDING_ASSIGN', () => pm.expect(json.data.status).to.eql('PENDING_ASSIGN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"打印机无法连接（已重新处理）\",\n  \"description\": null,\n  \"category\": \"硬件设备\",\n  \"priority\": \"URGENT\",\n  \"tags\": null,\n  \"operatorId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{id}}"
              ]
            },
            "description": "PUT 为全量替换：title/priority 必填，description/category/tags 传 null 即清空。operatorId 用于写操作日志，不是业务字段。"
          }
        },
        {
          "name": "4.2 更新工单（越权多传 status=CLOSED，应被忽略）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('状态仍为 PENDING_ASSIGN —— 更新接口无法改状态', () => pm.expect(json.data.status).to.eql('PENDING_ASSIGN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"试探越权改状态\",\n  \"priority\": \"MEDIUM\",\n  \"operatorId\": 2,\n  \"status\": \"CLOSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{id}}"
              ]
            },
            "description": "TicketUpdateDTO 不含 status 字段，JSON 中的多余字段被 Jackson 直接忽略，从结构上杜绝越权改状态。"
          }
        },
        {
          "name": "4.3 更新工单（缺 priority，应 40000）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=40000', () => pm.expect(json.code).to.eql(40000));",
                  "pm.test('message 指明字段 priority', () => pm.expect(json.message).to.include('priority'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"只改标题不带优先级\",\n  \"operatorId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{id}}"
              ]
            },
            "description": "PUT 全量替换语义下 priority 必填，避免「未传」与「清空」语义混淆。"
          }
        },
        {
          "name": "4.4 更新工单（不存在的工单，应 10003）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=10003', () => pm.expect(json.code).to.eql(10003));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"改一个不存在的工单\",\n  \"priority\": \"LOW\",\n  \"operatorId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "999999999"
              ]
            },
            "description": "先查存在性再更新，返回业务码 10003。"
          }
        }
      ]
    },
    {
      "name": "5. 操作日志 GET /api/tickets/{id}/logs",
      "item": [
        {
          "name": "5.1 查询操作日志（应含一条 CREATE 记录）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=0', () => pm.expect(json.code).to.eql(0));",
                  "pm.test('至少有一条日志', () => pm.expect(json.data.length).to.be.at.least(1));",
                  "const createLog = json.data.find((log) => log.action === 'CREATE');",
                  "pm.test('存在 CREATE 记录', () => pm.expect(createLog).to.be.an('object'));",
                  "pm.test('CREATE 记录字段完整', () => {",
                  "  pm.expect(createLog.toStatus).to.eql('PENDING_ASSIGN');",
                  "  pm.expect(createLog.operatorId).to.eql(1);",
                  "  pm.expect(createLog.ticketId).to.eql(Number(pm.collectionVariables.get('id')));",
                  "  pm.expect(createLog.createdAt).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{id}}/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{id}}",
                "logs"
              ]
            },
            "description": "按 created_at 升序返回。创建工单时同事务写入一条 CREATE 日志。"
          }
        },
        {
          "name": "5.2 查询操作日志（工单不存在，应 10003）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('code=10003', () => pm.expect(json.code).to.eql(10003));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/999999999/logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "999999999",
                "logs"
              ]
            },
            "description": "工单不存在时明确报错，而不是返回空列表让人误以为「这个工单没有日志」。"
          }
        }
      ]
    },
    {
      "name": "6. 指派与关闭 POST /api/tickets/{id}/assign | /close",
      "item": [
        {
          "name": "6.1 指派工单（待分配 → 处理中）",
          "event": [
            {
