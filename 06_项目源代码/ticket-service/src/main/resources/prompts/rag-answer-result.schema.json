{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartticket.local/schemas/rag-answer-result.schema.json",
  "title": "RAG 回答结果",
  "description": "rag-answer-v4.0：已有依据直接答，缺少用户信息先澄清，关键事实缺失或实际人工办理须提供结构化原因。旧三字段成功回答兼容，转人工必须提供handoff。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suggestion",
    "similarQuestions",
    "needHuman"
  ],
  "properties": {
    "suggestion": {
      "type": "string",
      "description": "一句可执行的处理建议，中文。不得照抄资料原文，不得带“建议：”这类前缀。注意：模板里要求不超过 80 字，这里与解析器放宽到 200——超长才说明模型没遵守格式，放宽一点是为了不因个别字超标就把整份响应用不了。",
      "minLength": 1,
      "maxLength": 200
    },
    "similarQuestions": {
      "type": "array",
      "description": "知识库里还有的相似问题（章程模块三「返回相似问题」）。每条应紧扣某一条知识库资料，不得引入资料之外的话题。",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "needHuman": {
      "type": "boolean",
      "description": "仅关键业务事实缺失或用户明确要求实际人工办理时为true；解释完整或需用户补信息时为false。"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "detail"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "ANSWERED",
            "NEEDS_CLARIFICATION",
            "INSUFFICIENT_EVIDENCE",
            "HUMAN_ACTION_REQUIRED"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "NONE",
            "USER_CONTEXT_REQUIRED",
            "CRITICAL_FACTS_MISSING",
            "HUMAN_OPERATION_REQUIRED"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 200
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "ANSWERED"
            },
            "reason": {
              "const": "NONE"
            },
            "detail": {
              "maxLength": 0
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "NEEDS_CLARIFICATION"
            },
            "reason": {
              "const": "USER_CONTEXT_REQUIRED"
            },
            "detail": {
              "minLength": 5
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "INSUFFICIENT_EVIDENCE"
            },
            "reason": {
              "const": "CRITICAL_FACTS_MISSING"
            },
            "detail": {
              "minLength": 5
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "HUMAN_ACTION_REQUIRED"
            },
            "reason": {
              "const": "HUMAN_OPERATION_REQUIRED"
            },
            "detail": {
              "minLength": 5
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "needHuman": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "handoff"
        ],
        "properties": {
          "handoff": {
            "properties": {
              "state": {
                "enum": [
                  "INSUFFICIENT_EVIDENCE",
                  "HUMAN_ACTION_REQUIRED"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "handoff": {
            "properties": {
              "state": {
                "enum": [
                  "ANSWERED",
                  "NEEDS_CLARIFICATION"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
