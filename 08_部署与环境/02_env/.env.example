# SmartTicket-AI 环境变量示例
# 用法：
#   1. 复制本文件为 08_部署与环境/01_docker/.env（compose 默认读取该目录下的 .env）
#   2. 填入真实值后执行 docker compose up -d
# 注意：真实的 .env / .env.local / .env.dev / .env.prod 已被 .gitignore 忽略，禁止提交到仓库。

# MySQL root 密码
# 对应 08_部署与环境/01_docker/docker-compose.yml 中的 ${MYSQL_ROOT_PASSWORD}
# 若沿用已初始化的数据卷，此处必须与当初创建容器时使用的密码一致，否则 MySQL 容器会启动失败。
MYSQL_ROOT_PASSWORD=change_me

# Redis 密码（阶段1 第10天加入）
# 对应 08_部署与环境/01_docker/docker-compose.yml 中 redis 服务的 --requirepass ${REDIS_PASSWORD}
# 同时被应用侧 application.yml 的 spring.data.redis.password 引用（本地开发在 application-local.yml 覆盖真实值）；
# 若 composes 设置了密码而应用侧没配，连接会被 Redis 拒绝（NOAUTH）。
REDIS_PASSWORD=change_me

# PostgreSQL（pgvector 向量库）postgres 用户密码（阶段2 第5天加入）
# 对应 08_部署与环境/01_docker/docker-compose.yml 中 pgvector 服务的 ${POSTGRES_PASSWORD}，
# 同时被应用侧 smartticket.vector.datasource.password 引用（本地开发在 application-local.yml 覆盖真实值）。
# 若沿用已初始化的数据卷，此处必须与当初创建容器时使用的密码一致，否则容器会启动失败。
POSTGRES_PASSWORD=change_me

# RabbitMQ 账号密码（阶段3 第6周加入）
# 对应 08_部署与环境/01_docker/docker-compose.yml 中 rabbitmq 服务的
# RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS，同时被应用侧 spring.rabbitmq.username / password 引用
# （本地开发在 application-local.yml 覆盖真实值）。
# 注意：这两个值只在**首次初始化数据卷**时生效；容器已存在后再改 .env 不会改变已有用户的密码，
#       要换密码需进容器用 rabbitmqctl change_password，或删卷重建。
# 不要留空：RABBITMQ_DEFAULT_PASS 为空时容器会创建"无密码用户"，应用侧连接会被拒。
RABBITMQ_USER=smartticket
RABBITMQ_PASSWORD=change_me
